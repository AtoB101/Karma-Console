# Model routing (OpenAI-compatible). Leave unset to use the deterministic mock provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
DEFAULT_MODEL_PROVIDER=mock

# Persistence
DATABASE_URL=sqlite:///./krama.db

# Deployment
KRAMA_REGION=CN

# Karma Network payment (leave KRAMA_API_KEY empty to use the deterministic stub)
KRAMA_API_BASE_URL=https://api.karma.xyz/v1
KRAMA_API_KEY=
KRAMA_AGENT_ID=
KRAMA_IDENTITY_ID=

# User-defined functions (SSRF guard for outbound URLs)
FUNCTION_ALLOW_PRIVATE=0
FUNCTION_TIMEOUT_SECONDS=15
# Secret encryption at rest (Fernet). Production must set KRAMA_SECRET_KEY and rotate it.
KRAMA_SECRET_KEY=
KRAMA_SECRET_KEY_FILE=./.secret.key

# Rate limiting (in-memory, per process)
CHAT_INBOUND_RATE_LIMIT=60
CHAT_INBOUND_RATE_WINDOW=60
EXECUTE_RATE_LIMIT=300
EXECUTE_RATE_WINDOW=60

# Persistent workflow: in-flight tasks older than this many seconds are
# recovered and resumed from their last checkpoint on the next run.
TASK_RESUME_TIMEOUT_SECONDS=600

# Workflow reliability: transient failures (unresolved receipts, network
# timeouts on idempotent tools) retry with exponential backoff; permanent
# errors (invalid params, denied policy, unknown tool) fail fast.
# WORKFLOW_MAX_RETRIES: extra attempts after the first (default 2).
# WORKFLOW_RETRY_BASE_SECONDS: first backoff base, doubled each attempt (default 1.0).
# WORKFLOW_RETRY_CAP_SECONDS: maximum backoff per attempt (default 30.0).
# RECONCILE_MAX_CONSECUTIVE_FAILURES: skip a workspace's reconciliation after
# this many consecutive failed passes, until a clean pass resets the counter.
WORKFLOW_MAX_RETRIES=2
WORKFLOW_RETRY_BASE_SECONDS=1.0
WORKFLOW_RETRY_CAP_SECONDS=30.0
RECONCILE_MAX_CONSECUTIVE_FAILURES=3

# Tiered retention (P6): purge expired volatile records; audit/memory/business
# data are permanently protected and never auto-deleted.
# RETENTION_ENABLED: 1 runs cleanup in the background loop (default 1).
# RETENTION_MESSAGES_DAYS: chat message history kept (default 30).
# RETENTION_CONVERSATIONS_DAYS: closed conversation threads kept (default 30).
# RETENTION_STOCK_MOVEMENTS_DAYS: inventory ledger kept (default 90).
# RETENTION_TODOS_DAYS: done/cancelled todos kept (default 30).
RETENTION_ENABLED=1
RETENTION_MESSAGES_DAYS=30
RETENTION_CONVERSATIONS_DAYS=30
RETENTION_STOCK_MOVEMENTS_DAYS=90
RETENTION_TODOS_DAYS=30

# Backup & recovery (M10 audit/recovery center)
# BACKUP_DIR: directory for SQLite consistent snapshots (created on demand).
# BACKUP_ENABLED: 1 enables the opt-in background loop (default 0 = manual only).
# BACKUP_INTERVAL_HOURS: minimum hours between scheduled backups (checked against
#   the newest healthy backup; only the first workspace owner triggers it).
# BACKUP_RETENTION: number of healthy backups kept per workspace; older files
#   and records are pruned (POST /backups/prune also applies it on demand).
BACKUP_DIR=./backups
BACKUP_ENABLED=0
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7

# ===== 外部联调凭证位（留空=离线演练；系统绝不伪造"连接成功"。填齐仅代表可发起真实连通测试，真实状态以对端回执为准）=====
# Karma 资金记账/结算（KRAMA_API_KEY / KRAMA_AGENT_ID / KRAMA_IDENTITY_ID 见上方 Deployment 段）

# 独立站商城
ECOM_INDEP_ENDPOINT=
ECOM_INDEP_API_KEY=

# 社交网店
ECOM_SOCIAL_ENDPOINT=
ECOM_SOCIAL_API_KEY=

# 淘宝开放平台（TOP 签名接入）
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ACCESS_TOKEN=

# 抖音电商（抖店签名接入）
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
DOUYIN_ACCESS_TOKEN=

# 顺丰速运物流
SF_PARTNER_ID=
SF_CHECKWORD=
SF_SERVICE_CODE=
SF_ENDPOINT=

# 通用物流（自定义 HTTP 轨迹查询）
LOGISTICS_ENDPOINT=
LOGISTICS_API_KEY=

# 运行日志默认写入 ./logs，按启动次数切分为 server_时间戳.log；无需配置。
