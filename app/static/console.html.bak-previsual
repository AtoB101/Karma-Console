function replyHtml(text){ return esc(text).replace(/\n/g,"<br>"); }

async function sendChat(){
  const message = $("#input").value.trim(); if(!message) return;
  $("#input").value = "";
  addMsg("user", replyHtml(message));
  const thinking = addMsg("assistant", '<span style="color:var(--muted)">处理中…</span>');
  try{
    const data = await fetchJson(`/workspaces/${state.workspaceId}/chat`,{method:"POST",headers:wsHeaders(),body:JSON.stringify({message})});
    let html = replyHtml(data.reply||"");
    if(data.intent==="product_display" && data.created && data.created.length){
      html += `<div class="card"><div class="t">已归类商品</div><ul style="margin:0;padding-left:18px">`+
        data.created.map(p=>`<li>${esc(p.name)} — ¥${p.price}</li>`).join("")+`</ul></div>`;
    }
    if(data.actions && data.actions.length){
      const trace = data.actions.map(a=>{
        const dec = a.decision || "";
        const tool = a.tool || a.name || "";
        const r = (a.result && typeof a.result === "object") ? a.result : {};
        const brief = r.error ? ("✗ "+esc(r.error))
          : (r.summary || r.reply || r.message || (r.receipt_status ? ("回执:"+esc(r.receipt_status)) : (r.id||r.product_id||r.order_id||r.area_id||r.function_id ? ("id:"+esc(r.id||r.product_id||r.order_id||r.area_id||r.function_id)) : "")));
        return `<div class="row"><span class="badge ${dec==="DENIED"?"r2":dec==="PENDING"?"r1":"r0"}">${esc(dec)}</span><span>${esc(tool)}</span><span style="color:var(--muted);font-size:11px">${brief}</span></div>`;
      }).join("");
      html += `<details class="card" open><summary class="t">执行链路（${data.actions.length} 步${data.plan_source?" · "+esc(data.plan_source):""}）</summary>${trace}</details>`;
    }
    const approvalId = pendingApprovalId(data);
    if(approvalId){
      html += `<div class="card" style="border-color:rgba(251,191,36,.45)">该操作需要你的批准，请在下方输入框上方点击「批准」或「拒绝」。</div>`;
    }
    if(data.hints && data.hints.length){
      html += `<div class="card" style="border-color:rgba(251,191,36,.4)">主脑安全提示：` +
        data.hints.map(h=>`<div style="margin:4px 0">${h.severity==="danger"?"⚠️":"💡"} ${esc(h.message)}</div>`).join("") +
        `</div>`;
      neuralSetHints(data.hints);
    }else{
      neuralSetHints([]);
    }
    thinking.innerHTML = `<div class="who">Agent</div><div class="bubble">${html}</div>`;
    if(approvalId){ showApprovalRequest(approvalId); }
    await Promise.all([loadCatalog(), loadAreas(), loadApprovals(), loadTodos()]);
  }catch(e){
    thinking.innerHTML = `<div class="who">Agent</div><div class="bubble" style="color:var(--danger)">${esc(e.message)}</div>`;
  }
  $("#msgs").scrollTop = $("#msgs").scrollHeight;
}

// ---- inline approval request (composer) ----
let pendingApproval = null;
function pendingApprovalId(data){
  if(data && data.approval_id){ return data.approval_id; }
  if(data && data.decision === "PENDING"){ return data.approval_id || null; }
  const acts = data && data.actions;
  if(Array.isArray(acts)){
    const pending = acts.find(a => a.decision === "PENDING" || a.approval_id);
    if(pending){ return pending.approval_id || null; }
  }
  return null;
}
async function showApprovalRequest(approvalId){
  try{
    const data = await fetchJson(`/workspaces/${state.workspaceId}/approvals`,{headers:wsHeaders()});
    const a = data.approvals.find(x => x.id === approvalId && x.status === "PENDING");
    if(!a){ clearApprovalRequest(); return; }
    pendingApproval = a;
    renderApprovalRequest();
  }catch(e){ /* approvals may be unavailable */ }
}
function renderApprovalRequest(){
  const a = pendingApproval;
  if(!a){ $("#approvalRequest").innerHTML = ""; return; }
  $("#approvalRequest").innerHTML = `
    <div class="approval-request">
      <div class="ar-head"><span class="ar-dot"></span>需要你的批准</div>
      <div class="ar-title">${esc(a.action)}</div>
      <div class="ar-meta">${esc(JSON.stringify(a.payload))}</div>
      <div class="ar-actions">
        <button class="small" onclick="resolveApproval(true)">批准</button>
        <button class="danger small" onclick="resolveApproval(false)">拒绝</button>
      </div>
    </div>`;
}
function clearApprovalRequest(){ pendingApproval = null; $("#approvalRequest").innerHTML = ""; }
async function resolveApproval(approve){
  if(!pendingApproval){ return; }
  const id = pendingApproval.id;
  try{
    await fetchJson(`/approvals/${id}/decision`,{method:"POST",headers:wsHeaders(),body:JSON.stringify({approve})});
    toast(approve ? "已批准" : "已拒绝");
    clearApprovalRequest();
    await Promise.all([loadApprovals(), loadTodos()]);
  }catch(e){ toast(e.message); }
}

