function prodsOf(areaId){ return products.filter(p=>p.layout_area_id===areaId); }
function fnOf(id){ return catalog.find(c=>c.type==="function" && c.id===id); }
function renderArea(a, all){
  const children = all.filter(x=>x.parent_id===a.id);
  const ps = prodsOf(a.id);
  const manageable = ["product","product_manage","product_display"].includes(a.target_type);
  const isFn = a.kind==="function" && a.target_type==="function" && a.target_id;
  const fn = isFn ? fnOf(a.target_id) : null;
  const stageBadge = a.stage==="test" ? `<span class="badge r2">测试</span>` : `<span class="badge r1">已上线</span>`;
  const inner = children.map(c=>renderArea(c, all)).join("") + ps.map(p=>`
    <div class="area-row"><span class="grow"><span class="prod">· ${esc(p.name)} ¥${p.price}</span>
      ${p.specs&&Object.keys(p.specs).length?`<div class="sub" style="font-size:11px;color:var(--muted)">${esc(Object.entries(p.specs).map(([k,v])=>k+":"+v).join("，"))}</div>`:""}
    </span>
    ${manageable?`<button class="small" onclick="openProdModal('${a.id}','${p.id}')">编辑</button>`:""}</div>`).join("");
  const addBtn = manageable ? `<div class="area-row"><button class="small" onclick="openProdModal('${a.id}')">＋ 添加产品</button></div>` : "";
  const fnDesc = fn ? `<div class="area-row"><div class="grow" style="color:var(--muted);font-size:11px">${esc(fn.description||fn.display_name||fn.name)}${fn.acceptance?` · 验收：${esc(fn.acceptance)}`:""}</div></div>` : "";
  const fnRun = fn ? `<div class="area-row"><button class="small" onclick="openRunFnModal('${a.target_id}','${esc(fn.display_name||a.name)}')">▶ 运行/测试</button></div>` : "";
  const promoteBtn = a.stage==="test" ? `<div class="area-row"><button class="small" onclick="promoteArea('${a.id}')">✅ 测试通过，上线到功能区</button></div>` : "";
  const caret = (children.length||ps.length||isFn) ? '<span class="caret">▸</span>' : '';
  return `<details open><summary>${caret}<span class="badge area">${esc(a.kind)}</span><span class="grow">${esc(a.name)}</span>${stageBadge}</summary>
    ${inner ? `<div class="area-row"><div class="grow" style="color:var(--muted);font-size:11px">子功能/商品</div></div>`+inner : ''}
    ${fnDesc}
    ${fnRun}
    ${addBtn}
    ${promoteBtn}
  </details>`;
}

