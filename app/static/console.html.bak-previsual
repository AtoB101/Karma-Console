  }catch(e){ toast(e.message); }
}

async function bizShip(orderId){
  const carrier = prompt("物流公司（可留空）","") || "";
  const tracking = prompt("运单号","");
  if(tracking===null) return;
  try{
    const res = await fetchJson("/gateway/execute",{method:"POST",headers:wsHeaders(),body:JSON.stringify({tool:"fulfill_order", params:{order_id:orderId, carrier, tracking_number:tracking}})});
    if(res.decision==="ALLOWED" && res.result && res.result.error){ toast(res.result.error); }
    else if(res.decision==="ALLOWED"){ toast("已发货并扣减库存"); }
    else if(res.decision==="PENDING"){ toast("需要审批"); loadApprovals(); loadTodos(); }
    else{ toast(res.reason||res.decision); }
    await loadBiz();
  }catch(e){ toast(e.message); }
}

async function bizDeliver(orderId){
  const shipment = bizShipments.find(s=>s.order_id===orderId);
  if(!shipment){ toast("未找到运单"); return; }
  try{
