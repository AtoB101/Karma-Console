<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Krama 控制台</title>
<style>
:root{
  --bg:#0d0f14; --panel:#151823; --panel2:#1c2030; --line:#262b3d;
  --text:#e8eaf2; --muted:#8a91a8; --accent:#7c5cff; --accent2:#9d84ff;
  --ok:#34d399; --warn:#fbbf24; --danger:#f87171; --info:#38bdf8;
  --user-bubble:#1f2436; --assistant-bubble:#161a29;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.6 "Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}
header{display:flex;align-items:center;gap:14px;padding:12px 18px;background:var(--panel);border-bottom:1px solid var(--line)}
.logo{font-weight:700;font-size:16px;letter-spacing:.5px}
.logo span{color:var(--accent2)}
.hidden{display:none!important}
button{background:var(--accent);color:#fff;border:0;border-radius:8px;padding:8px 14px;cursor:pointer;font-size:13px}
button:hover{background:var(--accent2)}
button.ghost{background:transparent;border:1px solid var(--line);color:var(--text)}
button.danger{background:transparent;border:1px solid var(--danger);color:var(--danger)}
button.small{padding:4px 9px;font-size:12px}
button.icon{padding:2px 7px;font-size:12px;background:transparent;border:1px solid var(--line);color:var(--muted)}
main{display:grid;grid-template-columns:260px 1fr 300px;height:calc(100vh - 57px)}
aside{background:var(--panel);overflow:auto;padding:14px}
#left{border-right:1px solid var(--line)}
#right{border-left:1px solid var(--line)}
h2{font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--muted);margin:0 0 10px}
.badge{display:inline-block;font-size:10px;padding:2px 7px;border-radius:20px;background:var(--line);color:var(--muted);white-space:nowrap}
.badge.r0{background:#12302a;color:var(--ok)} .badge.r1{background:#123c34;color:var(--ok)}
.badge.r2{background:#3a2f12;color:var(--warn)} .badge.r3{background:#3a1f1f;color:var(--danger)}
.badge.kind{background:#1c2340;color:var(--info)}
.badge.area{background:#241d3f;color:var(--accent2)}
.overview{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:14px}
.ov-title{font-size:12px;font-weight:700;margin-bottom:10px}
.ov-chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{display:inline-flex;align-items:center;gap:4px;background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:3px 9px;font-size:11px;color:var(--muted)}
.chip b{color:var(--text);font-weight:700}

/* chat */
#center{display:flex;flex-direction:column;height:100%;overflow:hidden}
#chat{display:flex;flex-direction:column;flex:1;min-height:0;background:var(--bg)}
#msgs{flex:1;overflow:auto;padding:24px 0}
.msg{max-width:780px;margin:0 auto 18px;padding:0 24px;display:flex;flex-direction:column}
.msg.user{align-items:flex-end}
.msg.assistant{align-items:flex-start}
.msg .who{font-size:12px;color:var(--muted);margin-bottom:4px}
.msg .bubble{max-width:88%;padding:10px 14px;border-radius:14px;line-height:1.65;white-space:pre-wrap;word-break:break-word}
.msg.user .bubble{background:var(--user-bubble);border:1px solid var(--line);border-bottom-right-radius:4px}
.msg.assistant .bubble{background:var(--assistant-bubble);border:1px solid var(--line);border-bottom-left-radius:4px}
.card{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-top:10px}
.card .t{font-weight:600;margin-bottom:6px}
.card li{margin:2px 0;color:var(--muted)}
#composer{max-width:780px;margin:0 auto;padding:0 24px 22px;width:100%}
#composer .box{display:flex;gap:10px;align-items:flex-end;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:10px}
textarea,input,select{background:#0d0f14;border:1px solid var(--line);color:var(--text);border-radius:8px;padding:8px 10px;font-size:13px;resize:none}
textarea{flex:1;border:0;background:transparent;resize:none;outline:none}
#send{flex-shrink:0}

/* left areas */
details{border:1px solid var(--line);border-radius:10px;margin-bottom:8px;background:var(--panel2)}
details summary{cursor:pointer;padding:9px 11px;font-size:13px;font-weight:600;list-style:none;display:flex;align-items:center;gap:8px}
details summary::-webkit-details-marker{display:none}
details summary .caret{transition:.15s;color:var(--muted)}
details[open] summary .caret{transform:rotate(90deg)}
.area-row{display:flex;align-items:center;gap:8px;padding:7px 10px 7px 24px;border-top:1px solid var(--line);font-size:13px}
.area-row .grow{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.area-row .sub{padding-left:44px}
.prod{font-size:11px;color:var(--muted);padding:2px 10px 2px 24px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lib-item{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;background:var(--panel2);border:1px solid var(--line);margin-bottom:6px}
.lib-item .grow{flex:1;min-width:0}
.lib-item .t{font-size:12px;font-weight:600}
.lib-item .d{font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.approval{background:var(--panel2);border:1px solid #3a2f12;border-radius:10px;padding:10px;margin-bottom:8px}
.todo{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:8px}
.todo.must_confirm{border-color:#3a2f12}
.todo.needs_reply{border-color:#123c34}
.todo.info{border-color:#1c2340}
.todo .kindtag{font-size:10px;padding:2px 6px;border-radius:12px;background:var(--line);color:var(--muted);margin-right:6px}
.todo .code{font-family:Consolas,monospace;letter-spacing:2px;font-weight:700}
.field{margin-bottom:10px} label{display:block;font-size:12px;color:var(--muted);margin-bottom:4px}
.row{display:flex;gap:10px} .row>*{flex:1}
#modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;z-index:50}
.modal{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;width:520px;max-height:90vh;overflow:auto}
.toast{position:fixed;bottom:20px;right:20px;background:var(--accent);color:#fff;padding:10px 16px;border-radius:10px;z-index:99}
#setup{min-height:calc(100vh - 57px);display:flex;align-items:center;justify-content:center;padding:24px}
.firstrun{width:400px;max-width:100%;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:32px 30px;text-align:left;box-shadow:0 24px 60px rgba(0,0,0,.45)}
.fr-logo{font-size:24px;font-weight:700;letter-spacing:.5px;margin-bottom:6px}
.fr-logo span{color:var(--accent2)}
.fr-sub{color:var(--muted);font-size:13px;margin:0 0 22px}
.firstrun .field{margin-bottom:14px}
.firstrun input{width:100%}
.firstrun button{margin-top:6px}
.empty{color:var(--muted);text-align:center;padding:30px 0}
.tabbar{display:flex;gap:8px;padding:10px 18px 0}
.tab{background:transparent;border:1px solid var(--line);color:var(--muted)}
.tab.active{background:var(--accent);border-color:var(--accent);color:#fff}
#biz{flex:1;overflow:auto;padding:16px 18px}
.biz-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:start}
.bizcard{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:14px}
.biz-row{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;margin-bottom:8px;background:var(--panel2)}
.biz-row .grow{flex:1;min-width:0}
.biz-t{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.biz-d{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.biz-actions{display:flex;gap:8px;margin-top:10px}
.biz-actions input{flex:1;min-width:0}
.biz-actions select{flex:1;min-width:0}
@media(max-width:1100px){.biz-grid{grid-template-columns:1fr}}
/* ---- neural console ---- */
#neural{position:fixed;inset:0;z-index:200;display:none;flex-direction:column;background:radial-gradient(1200px 700px at 50% 45%,#151a2b 0%,#0c0e15 60%,#080a10 100%)}
#neural.open{display:flex}
#neuralTop{display:flex;align-items:center;gap:12px;padding:12px 18px;background:rgba(21,24,35,.92);border-bottom:1px solid var(--line);backdrop-filter:blur(6px)}
#neuralTop .nt-title{font-weight:700;letter-spacing:.4px}
#neuralTop .nt-sub{font-size:11.5px;color:var(--muted)}
#neuralStage{position:relative;flex:1;overflow:hidden;background-image:radial-gradient(rgba(124,92,255,.14) 1px,transparent 1px);background-size:26px 26px}
#neuralSvg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
#brainNode{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:232px;max-height:52vh;display:flex;flex-direction:column;background:linear-gradient(180deg,rgba(124,92,255,.18),rgba(28,32,48,.96));border:1px solid rgba(124,92,255,.55);border-radius:18px;box-shadow:0 0 40px rgba(124,92,255,.35),inset 0 0 24px rgba(124,92,255,.08);padding:12px 13px;overflow:hidden}
#brainNode .bn-head{display:flex;align-items:center;gap:9px;font-weight:700;letter-spacing:.3px;margin-bottom:8px}
#brainNode .bn-pulse{width:10px;height:10px;border-radius:50%;background:var(--accent2);box-shadow:0 0 0 0 rgba(157,132,255,.7);animation:bnPulse 1.8s ease-out infinite}
#brainNode .bn-feed{flex:1;overflow:auto;font-size:11.5px;display:flex;flex-direction:column;gap:5px}
#brainNode .bn-hints{margin-top:8px;border-top:1px solid var(--line);padding-top:7px;font-size:11.5px;display:flex;flex-direction:column;gap:5px}
.nev{display:flex;gap:7px;align-items:baseline;padding:4px 7px;border-radius:8px;background:var(--panel2);border:1px solid var(--line)}
.nev .dot{width:7px;height:7px;border-radius:50%;flex:0 0 auto;align-self:center}
.nev.ALLOWED .dot{background:var(--ok)}
.nev.APPROVED .dot{background:var(--info)}
.nev.PENDING .dot{background:var(--warn)}
.nev.DENIED .dot{background:var(--danger)}
.nev .a{color:var(--text);font-weight:600}
.nev .r{color:var(--muted)}
.nhint{display:flex;gap:7px;padding:4px 7px;border-radius:8px;background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.35);font-size:11px;color:var(--text)}
.nhint.danger{background:rgba(248,113,113,.08);border-color:rgba(248,113,113,.45)}
.nhint .ic{flex:0 0 auto}
.npanel{position:absolute;width:248px;min-height:126px;background:linear-gradient(180deg,rgba(28,32,48,.96),rgba(21,24,35,.98));border:1px solid var(--line);border-radius:14px;box-shadow:0 14px 40px rgba(0,0,0,.45);display:flex;flex-direction:column;overflow:hidden}
.npanel.active{border-color:rgba(124,92,255,.65);box-shadow:0 14px 40px rgba(0,0,0,.5),0 0 22px rgba(124,92,255,.25)}
.npanel .np-head{display:flex;align-items:center;gap:8px;padding:9px 12px;cursor:grab;border-bottom:1px solid var(--line);font-weight:600;font-size:13px;user-select:none}
.npanel .np-head:active{cursor:grabbing}
.npanel .np-head .np-ic{font-size:15px}
.npanel .np-head .np-count{margin-left:auto;font-size:11px;color:var(--accent2);font-weight:700}
.npanel .np-body{padding:9px 12px;font-size:11.5px;color:var(--muted);overflow:auto;flex:1;max-height:200px}
.npanel .np-body .row{display:flex;gap:6px;justify-content:space-between;padding:2px 0;border-bottom:1px dashed rgba(38,43,61,.6)}
.npanel .np-body .row b{color:var(--text);font-weight:600}
.npanel .np-body .nptbl{width:100%;border-collapse:collapse;font-size:10.5px}
.npanel .np-body .nptbl th,.npanel .np-body .nptbl td{padding:3px 4px;text-align:left;border-bottom:1px solid var(--line);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:90px}
.npanel .np-body .metric{font-size:22px;font-weight:800;color:var(--text)}
.npanel .np-body .metric-cap{font-size:10px;color:var(--faint)}
.npanel .np-body .bars{display:flex;align-items:flex-end;gap:4px;height:70px;padding-top:4px}
.npanel .np-body .bar{flex:1;min-width:6px;background:linear-gradient(180deg,#6d5ef2,#8b7bff);border-radius:4px 4px 0 0}
.npanel .np-body .pie{width:64px;height:64px;border-radius:50%;margin:4px auto}
.npanel .np-body .pie-cap{text-align:center;font-size:10px;color:var(--faint)}
.npanel .np-body .npsearch{width:100%;background:var(--elev);border:1px solid var(--line);border-radius:8px;color:var(--text);padding:5px 8px;font-size:11px}
.nline{fill:none;stroke:rgba(124,92,255,.5);stroke-width:1.4;stroke-dasharray:4 6;animation:nFlow 1.1s linear infinite}
.nline.danger{stroke:rgba(248,113,113,.75)}
@keyframes nFlow{to{stroke-dashoffset:-20}}
@keyframes bnPulse{0%{box-shadow:0 0 0 0 rgba(157,132,255,.6)}70%{box-shadow:0 0 0 10px rgba(157,132,255,0)}100%{box-shadow:0 0 0 0 rgba(157,132,255,0)}}</style>
<style id="krama-ui">
/* ============ Krama commercial console design system ============ */
:root{
  --bg:#080a10;
  --bg-glow:radial-gradient(1100px 520px at 18% -8%,rgba(109,94,242,.18),transparent 55%),radial-gradient(900px 480px at 88% -12%,rgba(56,189,248,.12),transparent 55%);
  --panel:#0f121b;
  --panel2:#131726;
  --elev:#1a1f30;
  --line:#232a3d;
  --line-soft:#1b2132;
  --text:#eef1f8;
  --muted:#8b93a8;
  --faint:#5d6478;
  --accent:#6d5ef2;
  --accent2:#8b7bff;
  --cyan:#38bdf8;
  --grad:linear-gradient(135deg,#6d5ef2 0%,#38bdf8 100%);
  --ok:#34d399; --warn:#fbbf24; --danger:#f87171; --info:#38bdf8;
  --user-bubble:#1d2334; --assistant-bubble:#121726;
  --radius:14px;
  --shadow:0 10px 30px rgba(0,0,0,.35);
  --mono:"SFMono-Regular",Consolas,"Liberation Mono",monospace;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;background:var(--bg);color:var(--text);
  font:14px/1.6 "Inter","Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  overflow:hidden;
}
body::before{content:"";position:fixed;inset:0;background:var(--bg-glow);pointer-events:none;z-index:0}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:#252c40;border-radius:9px;border:2px solid transparent;background-clip:content-box}
::-webkit-scrollbar-thumb:hover{background:#333b54;background-clip:content-box}
::-webkit-scrollbar-track{background:transparent}
.hidden{display:none!important}

/* ---------- header ---------- */
header{
  position:relative;z-index:10;display:flex;align-items:center;gap:14px;
  height:62px;padding:0 20px;background:rgba(13,16,25,.82);backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line-soft);
}
.brand{display:flex;align-items:center;gap:11px}
.brand .mark{width:34px;height:34px;border-radius:10px;background:var(--grad);display:grid;place-items:center;font-weight:800;color:#fff;font-size:15px;box-shadow:0 6px 18px rgba(109,94,242,.35)}
.brand .name{font-weight:700;font-size:16px;letter-spacing:.4px}
.brand .name em{font-style:normal;color:var(--cyan)}
.brand .sub{font-size:11px;color:var(--faint);letter-spacing:.3px;margin-top:-2px}
#wsName{display:inline-flex;align-items:center;gap:8px;margin-left:6px;padding:5px 12px;border:1px solid var(--line);border-radius:20px;background:var(--panel2);color:var(--muted);font-size:12.5px;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#wsName::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px rgba(52,211,153,.18);flex:0 0 auto}
header .spacer{flex:1}
.hdr-actions{display:flex;align-items:center;gap:8px}

/* ---------- buttons ---------- */
button{
  background:var(--accent);color:#fff;border:0;border-radius:9px;padding:8px 15px;
  cursor:pointer;font-size:13px;font-weight:600;letter-spacing:.2px;transition:.16s;
}
button:hover{background:var(--accent2);transform:translateY(-1px)}
button:active{transform:translateY(0)}
button:disabled{opacity:.45;cursor:not-allowed;transform:none}
button.primary{background:var(--grad);box-shadow:0 6px 16px rgba(109,94,242,.3)}
button.primary:hover{box-shadow:0 8px 22px rgba(109,94,242,.42);background:var(--grad)}
button.ghost{background:transparent;border:1px solid var(--line);color:var(--text);font-weight:500}
button.ghost:hover{background:var(--elev);border-color:#323a52;color:var(--text)}
button.danger{background:transparent;border:1px solid rgba(248,113,113,.4);color:var(--danger)}
button.danger:hover{background:rgba(248,113,113,.12);border-color:var(--danger)}
button.small{padding:5px 10px;font-size:12px;border-radius:7px}
button.tiny{padding:3px 8px;font-size:11px;border-radius:6px}
button.icon{width:30px;height:30px;padding:0;display:inline-grid;place-items:center;background:transparent;border:1px solid var(--line);color:var(--muted)}

/* ---------- layout ---------- */
main{position:relative;z-index:1;display:grid;grid-template-columns:292px minmax(0,1fr) 344px;height:calc(100vh - 62px)}
aside{background:var(--panel);overflow:auto;padding:18px 16px 28px}
aside#left{border-right:1px solid var(--line-soft)}
aside#right{border-left:1px solid var(--line-soft);background:linear-gradient(180deg,#0f121b,#0c0f17)}

/* ---------- section labels ---------- */
h2{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.4px;color:var(--faint);margin:0 0 10px;display:flex;align-items:center;gap:8px}
h2::after{content:"";height:1px;flex:1;background:var(--line-soft)}
h2 .count{margin-left:auto;background:var(--elev);border:1px solid var(--line);color:var(--muted);padding:1px 8px;border-radius:10px;font-size:10px;letter-spacing:0}
h3{font-size:13px;font-weight:700;margin:0 0 8px;color:var(--text)}

/* ---------- badges / chips ---------- */
.badge{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;font-weight:700;padding:3px 8px;border-radius:20px;background:var(--elev);border:1px solid var(--line);color:var(--muted);white-space:nowrap;letter-spacing:.3px}
.badge.r0{background:rgba(52,211,153,.1);border-color:rgba(52,211,153,.28);color:var(--ok)}
.badge.r1{background:rgba(56,189,248,.1);border-color:rgba(56,189,248,.28);color:var(--info)}
.badge.r2{background:rgba(251,191,36,.1);border-color:rgba(251,191,36,.3);color:var(--warn)}
.badge.r3{background:rgba(248,113,113,.1);border-color:rgba(248,113,113,.3);color:var(--danger)}
.badge.kind{background:rgba(56,189,248,.08);border-color:rgba(56,189,248,.22);color:var(--cyan)}
.badge.area{background:rgba(109,94,242,.1);border-color:rgba(109,94,242,.3);color:var(--accent2)}
.badge.stage{font-weight:600}

/* overview / metrics */
.overview{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:var(--radius);padding:14px;margin-bottom:18px;box-shadow:var(--shadow)}
.ov-title{font-size:11px;font-weight:700;letter-spacing:1px;color:var(--faint);text-transform:uppercase;margin-bottom:11px}
.ov-chips{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.chip{display:flex;flex-direction:column;gap:1px;background:var(--elev);border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-size:11px;color:var(--muted)}
.chip b{color:var(--text);font-weight:700;font-size:16px;line-height:1.2}
.chip small{font-size:9.5px;color:var(--faint);letter-spacing:.4px;text-transform:uppercase}
.chip.alert{border-color:rgba(248,113,113,.35);background:rgba(248,113,113,.07)}
.chip.attention{border-color:rgba(251,191,36,.35);background:rgba(251,191,36,.07)}
.chip.okay{border-color:rgba(52,211,153,.3);background:rgba(52,211,153,.07)}
.chip.info{border-color:rgba(56,189,248,.3);background:rgba(56,189,248,.07)}

/* ---------- left: function areas ---------- */
details{border:1px solid var(--line);border-radius:11px;margin-bottom:9px;background:var(--panel2);overflow:hidden;transition:.16s}
details:hover{border-color:#2d3650}
details[open]{border-color:#2d3650}
details summary{cursor:pointer;padding:10px 12px;font-size:13px;font-weight:600;list-style:none;display:flex;align-items:center;gap:9px;background:linear-gradient(180deg,var(--elev),transparent)}
details summary::-webkit-details-marker{display:none}
details summary .caret{transition:.16s;color:var(--faint);font-size:10px}
details[open] summary .caret{transform:rotate(90deg);color:var(--accent2)}
.area-row{display:flex;align-items:center;gap:9px;padding:8px 11px 8px 26px;border-top:1px solid var(--line-soft);font-size:12.5px;color:var(--muted)}
.area-row:hover{background:rgba(109,94,242,.05)}
.area-row .grow{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
.prod{font-size:11px;color:var(--faint);padding:3px 10px 3px 26px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.prod::before{content:"• ";color:var(--accent2)}
.side-actions{display:flex;flex-direction:column;gap:7px;margin-top:12px}
.side-toolbar{display:grid;grid-template-columns:1fr 1fr;gap:7px}

/* library */
#libDetails summary{font-size:12.5px}
.lib-item{display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:9px;background:var(--panel2);border:1px solid var(--line);margin-bottom:7px;cursor:pointer;transition:.14s}
.lib-item:hover{border-color:var(--accent);background:rgba(109,94,242,.08)}
.lib-item .grow{flex:1;min-width:0}
.lib-item .t{font-size:12px;font-weight:600;color:var(--text)}
.lib-item .d{font-size:10.5px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}

/* ---------- center: chat ---------- */
#center{display:flex;flex-direction:column;height:100%;overflow:hidden;background:transparent}
.tabbar{display:flex;gap:6px;padding:12px 18px 0;align-items:center}
.tab{background:transparent;border:1px solid transparent;color:var(--muted);font-weight:600;padding:8px 16px;border-radius:9px}
.tab:hover{background:var(--panel2);color:var(--text)}
.tab.active{background:linear-gradient(180deg,var(--elev),var(--panel2));border-color:var(--line);color:var(--text);box-shadow:var(--shadow)}
#chat{display:flex;flex-direction:column;flex:1;min-height:0}
#msgs{flex:1;overflow:auto;padding:26px 0;scroll-behavior:smooth}
.msg{max-width:820px;margin:0 auto 20px;padding:0 26px;display:flex;flex-direction:column}
.msg.user{align-items:flex-end}
.msg.assistant{align-items:flex-start}
.msg .who{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:700;color:var(--faint);letter-spacing:.4px;margin-bottom:7px;text-transform:uppercase}
.msg.assistant .who::before{content:"K";width:20px;height:20px;border-radius:6px;background:var(--grad);color:#fff;display:grid;place-items:center;font-size:11px;font-weight:800}
.msg .bubble{max-width:88%;padding:12px 16px;border-radius:15px;line-height:1.68;white-space:pre-wrap;word-break:break-word;font-size:14px;box-shadow:var(--shadow)}
.msg.user .bubble{background:linear-gradient(180deg,var(--user-bubble),#1a2032);border:1px solid #2a3148;border-bottom-right-radius:5px}
.msg.assistant .bubble{background:linear-gradient(180deg,var(--assistant-bubble),#101521);border:1px solid var(--line-soft);border-bottom-left-radius:5px}
.card{background:var(--panel2);border:1px solid var(--line);border-radius:11px;padding:11px 13px;margin-top:10px}
.card .t{font-weight:700;margin-bottom:6px;color:var(--text);font-size:12.5px}
.card li{margin:3px 0;color:var(--muted);font-size:13px}
#composer{max-width:820px;margin:0 auto;padding:6px 26px 24px;width:100%}
#composer .box{display:flex;gap:10px;align-items:flex-end;background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:10px 10px 10px 16px;box-shadow:var(--shadow);transition:.16s}
#composer .box:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(109,94,242,.15),var(--shadow)}
textarea,input,select{background:#0b0e16;border:1px solid var(--line);color:var(--text);border-radius:9px;padding:9px 11px;font-size:13px;transition:.14s;font-family:inherit}
textarea:focus,input:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(109,94,242,.14)}
textarea{flex:1;border:0;background:transparent;resize:none;outline:none;box-shadow:none;padding:4px 0}
#send{flex-shrink:0;padding:9px 20px}

/* ---------- right: todos & approvals ---------- */
.todo,.approval{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:11px;padding:11px 12px;margin-bottom:9px;transition:.14s}
.todo:hover,.approval:hover{border-color:#2d3650}
.todo.must_confirm{border-color:rgba(248,113,113,.35);background:linear-gradient(180deg,rgba(248,113,113,.07),var(--panel))}
.todo.needs_reply{border-color:rgba(52,211,153,.3)}
.todo.info{border-color:rgba(56,189,248,.25)}
.todo .kindtag,.approval .kindtag{font-size:10px;font-weight:700;padding:2px 7px;border-radius:11px;background:var(--elev);border:1px solid var(--line);color:var(--muted);margin-right:6px;letter-spacing:.4px}
.todo.must_confirm .kindtag{background:rgba(248,113,113,.12);border-color:rgba(248,113,113,.3);color:var(--danger)}
.todo.needs_reply .kindtag{background:rgba(52,211,153,.1);border-color:rgba(52,211,153,.3);color:var(--ok)}
.todo.info .kindtag{background:rgba(56,189,248,.1);border-color:rgba(56,189,248,.3);color:var(--cyan)}
.todo .title,.approval .title{font-weight:700;font-size:13px;color:var(--text);line-height:1.4}
.todo .meta,.approval .meta{font-size:11px;color:var(--faint);margin:4px 0 8px;word-break:break-all;line-height:1.5}
.todo .code{font-family:var(--mono);letter-spacing:3px;font-weight:700;color:var(--accent2);background:rgba(109,94,242,.1);border:1px solid rgba(109,94,242,.3);border-radius:7px;padding:2px 8px;display:inline-block}
.todo-actions{display:flex;gap:7px;margin-top:8px;align-items:center}
.todo-actions input{flex:1;min-width:0;font-family:var(--mono);letter-spacing:2px}
.btn-row{display:flex;gap:7px;margin-top:8px}
.divider{height:1px;background:var(--line-soft);margin:18px 0 14px}

/* ---------- forms ---------- */
.field{margin-bottom:12px}
label{display:block;font-size:11.5px;font-weight:600;color:var(--muted);margin-bottom:5px;letter-spacing:.2px}
label small{color:var(--faint);font-weight:400;margin-left:6px}
.row{display:flex;gap:12px} .row>*{flex:1}
input[type=number]{-moz-appearance:textfield}

/* ---------- modals ---------- */
.modal-overlay{position:fixed;inset:0;background:rgba(5,7,12,.66);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:50;padding:22px}
.modal{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:16px;padding:24px;width:560px;max-width:100%;max-height:90vh;overflow:auto;box-shadow:0 30px 80px rgba(0,0,0,.55);animation:pop .18s ease}
@keyframes pop{from{opacity:0;transform:translateY(8px) scale(.985)}to{opacity:1;transform:none}}
.modal h2{margin-bottom:18px;font-size:15px}
.modal .row{align-items:flex-end}

/* ---------- toast ---------- */
.toast{position:fixed;bottom:22px;right:22px;background:var(--grad);color:#fff;padding:11px 18px;border-radius:11px;z-index:99;font-weight:600;font-size:13px;box-shadow:0 12px 30px rgba(0,0,0,.4);animation:pop .2s ease}

/* ---------- first run ---------- */
#setup{position:relative;z-index:1;min-height:calc(100vh - 62px);display:flex;align-items:center;justify-content:center;padding:26px}
.firstrun{width:440px;max-width:100%;background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:20px;padding:36px 34px;text-align:left;box-shadow:0 40px 100px rgba(0,0,0,.55)}
.fr-logo{font-size:26px;font-weight:800;letter-spacing:.4px;margin-bottom:8px;display:flex;align-items:center;gap:12px}
.fr-logo .mark{width:42px;height:42px;border-radius:12px;background:var(--grad);display:grid;place-items:center;color:#fff;font-size:19px;box-shadow:0 8px 24px rgba(109,94,242,.4)}
.fr-logo em{font-style:normal;color:var(--cyan)}
.fr-sub{color:var(--muted);font-size:13.5px;margin:0 0 24px;line-height:1.7}
.fr-features{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:0 0 24px;padding:0;list-style:none}
.fr-features li{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--muted);background:var(--elev);border:1px solid var(--line);border-radius:9px;padding:9px 11px}
.fr-features li::before{content:"✓";color:var(--ok);font-weight:800}
.firstrun .field{margin-bottom:15px}
.firstrun input{width:100%;padding:11px 12px;border-radius:10px}
.firstrun button{margin-top:8px;width:100%;padding:12px}

/* ---------- biz dashboard ---------- */
#biz{flex:1;overflow:auto;padding:18px 20px 30px}
.biz-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:start}
.bizcard{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow)}
.bizcard h2{margin-bottom:14px}
.biz-row{display:flex;align-items:center;gap:10px;padding:11px 12px;border:1px solid var(--line);border-radius:10px;margin-bottom:9px;background:var(--elev);transition:.13s}
.biz-row:hover{border-color:#2d3650}
.biz-row .grow{flex:1;min-width:0}
.biz-t{font-size:13px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.biz-d{font-size:11.5px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
.biz-actions{display:flex;gap:8px;margin-top:12px}
.biz-actions input{flex:1;min-width:0}
.biz-actions select{flex:1;min-width:0}
.empty{color:var(--faint);text-align:center;padding:34px 0;font-size:13px}
.empty::before{content:"◌";display:block;font-size:22px;color:var(--faint);margin-bottom:6px;opacity:.6}

/* ---------- responsive ---------- */
@media(max-width:1240px){main{grid-template-columns:260px minmax(0,1fr) 320px}}
@media(max-width:1020px){main{grid-template-columns:1fr} aside#left,aside#right{display:none} #center{height:calc(100vh - 62px)}}
@media(max-width:720px){.biz-grid{grid-template-columns:1fr}}
#modal,#setModal,#prodModal,#runFnModal{position:fixed;inset:0;background:rgba(5,7,12,.66);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:50;padding:22px}
#modal.hidden,#setModal.hidden,#prodModal.hidden,#runFnModal.hidden{display:none!important}
/* inline approval request at the composer */
#approvalRequest{margin-bottom:12px}
.approval-request{background:linear-gradient(180deg,rgba(251,191,36,.1),var(--panel2));border:1px solid rgba(251,191,36,.4);border-radius:13px;padding:13px 15px;box-shadow:var(--shadow);animation:pop .18s ease}
.approval-request .ar-head{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--warn)}
.approval-request .ar-dot{width:8px;height:8px;border-radius:50%;background:var(--warn);box-shadow:0 0 0 4px rgba(251,191,36,.18);animation:pulse 1.6s infinite}
.approval-request .ar-title{font-size:14px;font-weight:700;color:var(--text);margin:7px 0 4px}
.approval-request .ar-meta{font-size:12px;color:var(--muted);font-family:var(--mono);word-break:break-all;line-height:1.55;max-height:72px;overflow:auto;background:rgba(0,0,0,.22);border:1px solid var(--line);border-radius:8px;padding:7px 9px}
.approval-request .ar-actions{display:flex;gap:8px;margin-top:11px}
.approval-request .ar-actions button{flex:1;padding:9px;font-weight:700}
.approval-request .ar-actions .danger{border-color:rgba(248,113,113,.5)}
@keyframes pulse{0%,100%{box-shadow:0 0 0 4px rgba(251,191,36,.18)}50%{box-shadow:0 0 0 7px rgba(251,191,36,.06)}}
/* ---------- codex-style composer ---------- */
#composer .composer{display:flex;flex-direction:column;background:var(--panel2);border:1px solid var(--line);border-radius:18px;padding:10px 10px 8px 16px;box-shadow:0 10px 30px rgba(0,0,0,.35);transition:border-color .16s,box-shadow .16s}
#composer .composer:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(109,94,242,.16),0 12px 34px rgba(0,0,0,.4)}
#composer textarea{flex:1;border:0;background:transparent;resize:none;outline:none;box-shadow:none;color:var(--text);font-size:14px;line-height:1.65;min-height:26px;max-height:220px;overflow:auto;padding:4px 0 6px}
#composer textarea::placeholder{color:var(--faint)}
.composer-bar{display:flex;align-items:center;gap:8px;margin-top:2px}
.composer-left{display:flex;align-items:center;gap:6px;flex:1;min-width:0}
.composer-right{display:flex;align-items:center;gap:10px;margin-left:auto}
.c-tool{display:inline-flex;align-items:center;gap:7px;background:transparent;border:1px solid transparent;color:var(--muted);font-size:12px;font-weight:600;padding:5px 9px;border-radius:9px}
.c-tool:hover{background:var(--elev);border-color:var(--line);color:var(--text);transform:none}
.c-dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px rgba(52,211,153,.15);flex:0 0 auto}
.c-dot.off{background:var(--faint);box-shadow:none}
.c-caret{font-size:9px;color:var(--faint)}
.c-hint{font-size:11px;color:var(--faint);white-space:nowrap}
.send-btn{width:32px;height:32px;padding:0;border-radius:9px;display:grid;place-items:center;background:var(--grad);color:#fff;box-shadow:0 4px 12px rgba(109,94,242,.35);transition:.15s;flex:0 0 auto}
.send-btn:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(109,94,242,.45)}
.send-btn:disabled{opacity:.4;transform:none;box-shadow:none}
@media(max-width:720px){.c-hint{display:none}}
.plus-wrap{position:relative}
.c-tool.plus{width:32px;height:32px;padding:0;justify-content:center;border-radius:9px}
.c-tool.plus svg{display:block}
.plus-menu{position:absolute;bottom:calc(100% + 10px);left:0;width:230px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:6px;box-shadow:0 18px 50px rgba(0,0,0,.5);z-index:60;animation:pop .16s ease}
.pm-head{font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--faint);padding:7px 10px 5px}
.pm-item{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:transparent;border:0;border-radius:9px;color:var(--text);font-size:13px;font-weight:500;padding:9px 10px;margin:1px 0}
.pm-item:hover{background:var(--elev);color:var(--text);transform:none}
.pm-item span{width:18px;text-align:center}
/* skill marketplace (left panel) */
#skillsArea{display:flex;flex-direction:column;gap:7px;margin-bottom:4px}
.skill-item{display:flex;align-items:center;gap:10px;background:var(--panel2);border:1px solid var(--line);border-radius:11px;padding:10px 11px;transition:.14s}
.skill-item:hover{border-color:#2d3650}
.skill-item.installed{border-color:rgba(109,94,242,.4);background:linear-gradient(180deg,rgba(109,94,242,.08),var(--panel2))}
.skill-icon{width:32px;height:32px;flex:0 0 auto;display:grid;place-items:center;font-size:16px;background:var(--elev);border:1px solid var(--line);border-radius:9px}
.skill-body{flex:1;min-width:0}
.skill-t{font-size:12.5px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:6px;white-space:nowrap;overflow:hidden}
.skill-d{font-size:10.5px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.skill-item .small{flex:0 0 auto}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="mark">K</div>
    <div>
      <div class="name">Krama<em> Agent</em></div>
      <div class="sub">商业操作系统 · Business OS</div>
    </div>
  </div>
  <div id="wsName"></div>
  <div class="spacer"></div>
  <div class="hdr-actions">
    <button class="ghost small" onclick="toggleNeural()">🧠 神经控制台</button>
    <button class="ghost small" onclick="openSetModal()">⚙ 设置</button>
    <button class="ghost small" onclick="resetAll()">重置环境</button>
  </div>
</header>

<div id="setup">
  <div class="firstrun">
    <div class="fr-logo"><div class="mark">K</div><div>Krama<em> Agent</em></div></div>
    <p class="fr-sub">配置一次模型 Key，Agent 即开始在你的安全框架下自主落地：上架商品、报价谈判、库存物流、收款回执、待办确认。</p>
    <ul class="fr-features">
      <li>一句话落地功能</li>
      <li>全链路执行与回执</li>
      <li>主人权限确认</li>
      <li>Karma 收款预留</li>
    </ul>
    <div class="field"><label>模型 Key</label><input id="first_model_key" type="password" placeholder="sk-..." autocomplete="off"></div>
    <div class="field"><label>模型名</label><input id="first_model_name" value="deepseek-chat"></div>
    <div class="field"><label>Base URL</label><input id="first_model_base" value="https://api.deepseek.com"></div>
    <button id="firstRunBtn" onclick="firstRunStart()" style="width:100%;padding:12px">保存并启动</button>
  </div>
</div>

<main id="app" class="hidden">
  <aside id="left">
    <div id="overviewCard" class="overview hidden">
      <div class="ov-title">生意概览</div>
      <div id="overview" class="ov-chips"></div>
    </div>
    <h2>功能区</h2>
    <div id="areas"></div>
    <h2 style="margin-top:18px">技能区（可安装）</h2>
    <div id="skillsArea"></div>
    <h2 style="margin-top:16px">模块市场（可安装）</h2>
    <div id="marketArea"></div>
    <h2 style="margin-top:16px">组件库（折叠）</h2>
    <details id="libDetails">
      <summary><span class="caret">▸</span> 内置工具与功能</summary>
      <div id="library" style="padding:8px 4px"></div>
    </details>
    <div style="margin-top:10px"><button class="small ghost" onclick="openFnModal()">＋ 新建功能</button></div>
    <div style="margin-top:6px"><button class="small ghost" onclick="$('#fileInput').click()">📎 上传数据文件（CSV/JSON）</button><input id="fileInput" type="file" accept=".csv,.json,.txt,.md" style="display:none" onchange="uploadFile(this)"><input id="imageInput" type="file" accept="image/*" style="display:none" onchange="uploadFile(this)"></div>
    <div style="margin-top:18px;border-top:1px solid var(--line);padding-top:12px">
      <button class="small ghost" onclick="openSetModal()" style="width:100%">⚙ 设置（模型 / 聊天工具接入）</button>
    </div>
  </aside>

  <div id="center">
    <div class="tabbar">
      <button id="tabChat" class="tab active" onclick="showTab('chat')">对话</button>
      <button id="tabBiz" class="tab" onclick="showTab('biz')">业务看板</button>
    </div>
    <section id="chat">
    <div id="msgs">
      <div class="msg assistant"><div class="bubble">你好，我是你的商业 Agent。直接用自然语言告诉我做什么，例如：\n「在测试功能区给我加上一个产品展示区，把 棉麻衬衫 99元、牛仔裤 159元 归类进去」\n所有操作都会经过权限、审批与回执核验链路。</div></div>
    </div>
    <div id="composer">
      <div id="approvalRequest"></div>
      <div class="composer" id="composerBox">
        <textarea id="input" rows="1" placeholder="给 Agent 发指令…"></textarea>
        <div class="composer-bar">
          <div class="composer-left">
            <div class="plus-wrap">
              <button class="c-tool plus" id="plusBtn" onclick="togglePlusMenu()" title="添加内容">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
              </button>
              <div id="plusMenu" class="plus-menu hidden">
                <div class="pm-head">添加内容</div>
                <button class="pm-item" onclick="plusAction('file')"><span>📎</span> 上传数据文件</button>
                <button class="pm-item" onclick="plusAction('image')"><span>🖼</span> 上传图片</button>
                <button class="pm-item" onclick="plusAction('product')"><span>🛒</span> 添加产品</button>
                <button class="pm-item" onclick="plusAction('function')"><span>🧩</span> 新建功能</button>
                <button class="pm-item" onclick="plusAction('connector')"><span>🔌</span> 连接渠道</button>
                <button class="pm-item" onclick="plusAction('settings')"><span>⚙</span> 模型 / 聊天设置</button>
              </div>
            </div>
            <button class="c-tool" id="modelChip" onclick="openSetModal()" title="模型设置">
              <span class="c-dot"></span><span id="modelChipLabel">模型</span><span class="c-caret">▾</span>
            </button>
          </div>
          <div class="composer-right">
            <span class="c-hint">Enter 发送 · Shift+Enter 换行</span>
            <button id="mic" class="c-tool" onclick="toggleVoice()" title="语音输入">🎤</button>
            <button id="send" class="send-btn" onclick="sendChat()" title="发送">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
    </section>

    <section id="biz" class="hidden">
