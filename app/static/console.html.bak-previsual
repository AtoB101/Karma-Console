  if(!product_id || quantity<=0){ toast("请选择商品并填写正数数量"); return; }
  try{
    const res = await fetchJson("/gateway/execute",{method:"POST",headers:wsHeaders(),body:JSON.stringify({tool:"add_stock", params:{product_id, quantity}})});
    if(res.decision==="ALLOWED"){ toast("已入库"); $("#bizStockQty").value=""; await Promise.all([loadBizInventory(), loadAreas()]); }
    else if(res.decision==="PENDING"){ toast("需要审批"); loadApprovals(); loadTodos(); }
