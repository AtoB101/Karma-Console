function renderWebhookInfo(c){
  if(!c || !c.enabled){ $("#webhookInfo").innerHTML = "已停用接入。"; return; }
  const origin = location.origin || "http://127.0.0.1:8000";
  const provider = (c.provider || "telegram").toLowerCase();
  let html = "接入点（平台侧直接填这里）：<br>";
  if(provider === "telegram"){
    html += `<code>POST ${origin}/webhooks/telegram/你的BotToken</code><br>说明：Telegram 用 setWebhook 指向此地址即可，bot 收到消息会自动回复/报价/接单。`;
  } else {
    html += `<code>POST ${origin}/webhooks/${provider}?token=你的token</code><br>说明：微信/通用 webhook 把平台消息转发到此地址，agent 会自动回复。`;
  }
  html += `<br><br>通用接口（任意平台自建转发）：<code>POST ${origin}/chat/inbound</code><br>Body：<code>{&quot;token&quot;:&quot;你的token&quot;,&quot;message&quot;:&quot;用户指令&quot;,&quot;external_id&quot;:&quot;客户id&quot;,&quot;channel&quot;:&quot;telegram&quot;}</code>`;
  $("#webhookInfo").innerHTML = html;
}

