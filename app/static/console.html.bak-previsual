</div><script>
const state = { userId:null, apiKey:null, workspaceId:null, workspaceName:null };
const LS_KEY = "krama.console.v1";
const $ = s => document.querySelector(s);
let catalog = [];
let products = [];

function toast(msg){ const t=document.createElement("div"); t.className="toast"; t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),2600); }
function loadState(){ try{ Object.assign(state, JSON.parse(localStorage.getItem(LS_KEY)||"{}")); }catch(e){} }
function saveState(){ localStorage.setItem(LS_KEY, JSON.stringify(state)); }
function resetAll(){ localStorage.removeItem(LS_KEY); location.reload(); }

async function fetchJson(path, opts){
  const res = await fetch(path, opts);
  if(!res.ok){ let d=res.statusText; try{ d=(await res.json()).detail||d; }catch(e){} throw new Error(d||("HTTP "+res.status)); }
  if(res.status===204) return null;
  return res.json();
}
function baseHeaders(){ return {"Content-Type":"application/json"}; }
function authHeaders(){ return {...baseHeaders(), "Authorization":"Bearer "+state.apiKey}; }
function wsHeaders(){ return {...authHeaders(), "X-Workspace-Id": state.workspaceId}; }

async function setup(){
  const email = "console-"+Date.now()+"@local";
  const u = await fetchJson("/users",{method:"POST",headers:baseHeaders(),body:JSON.stringify({email, display_name:"商家"})});
  const k = await fetchJson(`/users/${u.id}/api-keys`,{method:"POST",headers:baseHeaders()});
  const w = await fetchJson("/workspaces",{method:"POST",headers:{...baseHeaders(),"Authorization":"Bearer "+k.api_key},body:JSON.stringify({name:"我的店铺",region:"CN",business_category:"clothing"})});
  state.userId=u.id; state.apiKey=k.api_key; state.workspaceId=w.id; state.workspaceName=w.name;
  saveState();
}

async function firstRunStart(){
  const btn = $("#firstRunBtn");
  btn.disabled = true; btn.textContent = "启动中…";
  try{
    await setup();
    const body = {model:{
      provider: "openai_compat",
      base_url: $("#first_model_base").value.trim() || "https://api.deepseek.com",
      model: $("#first_model_name").value.trim() || "deepseek-chat",
      api_key: $("#first_model_key").value.trim(),
    }};
    await fetchJson(`/workspaces/${state.workspaceId}/settings`,{method:"PUT",headers:wsHeaders(),body:JSON.stringify(body)});
    toast("模型已保存，Agent 已启动");
    enter();
  }catch(e){
    toast("启动失败："+e.message);
    btn.disabled = false; btn.textContent = "保存并启动";
  }
}

function enter(){
  $("#setup").classList.add("hidden"); $("#app").classList.remove("hidden");
  $("#wsName").textContent = state.workspaceName || "";
  refresh();
}
async function refresh(){
  await Promise.all([loadCatalog(), loadAreas(), loadApprovals(), loadTodos(), loadSettings(), loadOverview(), loadSkills(), loadMarket()]);
  fillDirectSelect();
}
function esc(s){ return String(s??"").replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

async function loadCatalog(){
  catalog = (await fetchJson(`/workspaces/${state.workspaceId}/catalog`,{headers:wsHeaders()})).catalog;
  const groups = {tool:"内置工具", connector:"连接器", function:"自定义功能"};
  $("#library").innerHTML = Object.keys(groups).map(k=>{
    const items = catalog.filter(c=>c.type===k);
    return `<div style="margin:8px 0 2px;font-size:11px;color:var(--muted)">${groups[k]}</div>` + items.map(item=>{
      const badge = item.risk_level ? `<span class="badge r${(item.risk_level||'r0').toLowerCase()}">${item.risk_level}</span>` : "";
      const kind = item.kind ? `<span class="badge kind">${item.kind}</span>` : "";
      const name = item.name || item.connector_type;
      const desc = item.description || item.connector_type || item.category || "";
      return `<div class="lib-item" data-type="${item.type}" data-name="${esc(name)}" data-id="${item.id||""}" data-ctype="${item.connector_type||""}">
        <div class="grow"><div class="t">${esc(name)}</div><div class="d">${esc(desc)}</div></div>${badge}${kind}
        <button class="icon" onclick="addFromLibrary(this.parentElement)">＋</button>
      </div>`;
    }).join("");
  }).join("");
}

async function loadAreas(){
  const areas = (await fetchJson(`/workspaces/${state.workspaceId}/layout`,{headers:wsHeaders()})).areas;
  products = (await fetchJson(`/workspaces/${state.workspaceId}/products`,{headers:wsHeaders()})).products;
  const roots = areas.filter(a=>!a.parent_id);
  const live = roots.filter(a=>a.stage!=="test");
  const test = roots.filter(a=>a.stage==="test");
  const section = (title, list) => `<div style="margin:10px 0 6px;font-size:11px;color:var(--muted)">${title}</div>` + (list.length ? list.map(a=>renderArea(a, areas)).join("") : `<div class="empty" style="padding:12px 0">（空）</div>`);
  $("#areas").innerHTML = section("功能区（已上线）", live) + section("测试功能区（开发/测试）", test);
}

