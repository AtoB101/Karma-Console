function neuralOpenStream(){
  if(neuralStreamCtl) neuralStreamCtl.abort();
  neuralStreamCtl = new AbortController();
  (async ()=>{
    try{
      const res = await fetch(`/workspaces/${state.workspaceId}/brain/stream?interval=0.8`,{headers:wsHeaders(), signal:neuralStreamCtl.signal});
      if(!res.ok || !res.body) return;
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = "";
      while(true){
        const {done, value} = await reader.read();
        if(done) break;
        buf += decoder.decode(value, {stream:true});
        let idx;
        while((idx = buf.indexOf("\n\n")) >= 0){
          const chunk = buf.slice(0, idx); buf = buf.slice(idx+2);
          let event=null, data=null;
          for(const line of chunk.split("\n")){
            if(line.startsWith("event: ")) event = line.slice(7);
            else if(line.startsWith("data: ")){ try{ data = JSON.parse(line.slice(6)); }catch(_){} }
          }
          if(event && data) neuralHandleStreamEvent(event, data);
        }
      }
    }catch(e){ /* aborted or offline */ }
  })();
}
function neuralCloseStream(){ if(neuralStreamCtl){ neuralStreamCtl.abort(); neuralStreamCtl=null; } }
function neuralHandleStreamEvent(event, data){
  if(event==="snapshot"){ neuralFeed = data.events||[]; }
  else if(event==="event"){ neuralFeed = [data, ...(neuralFeed||[]).filter(e=>e.id!==data.id)].slice(0,60); }
  else return;
  neuralDanger = neuralFeed.some(e=>e.decision==="DENIED");
  neuralRenderFeed();
  neuralDraw();
}
async function neuralRefreshPanels(){
  for(const p of NEURAL_PANELS){
    const body = document.getElementById("npbody-"+p.id);
    const count = document.getElementById("npcount-"+p.id);
    if(!body) continue;
    try{
      const d = await fetchJson(`/workspaces/${state.workspaceId}/${p.ep}`,{headers:wsHeaders()});
      body.innerHTML = p.render(d);
      if(count) count.textContent = p.count(d);
    }catch(e){ body.innerHTML = `<span style="color:var(--danger)">读取失败</span>`; if(count) count.textContent="—"; }
  }
  for(const p of neuralCustom){
    const body = document.getElementById("npbody-"+p.id);
    const count = document.getElementById("npcount-"+p.id);
    if(!body) continue;
    try{
      const ep = p.data_source || "dashboard";
      const d = await fetchJson(`/workspaces/${state.workspaceId}/${ep}`,{headers:wsHeaders()});
      body.innerHTML = neuralRenderCustomBody(p, d);
      if(count) count.textContent = ((d && d[p.data_source]) || []).length || "—";
    }catch(e){ body.innerHTML = `<span style="color:var(--danger)">读取失败</span>`; if(count) count.textContent="—"; }
  }
}
function neuralSetHints(hints){
  const el = $("#brainHints"); if(!el) return;
  if(!hints || !hints.length){ el.classList.add("hidden"); el.innerHTML=""; return; }
  el.classList.remove("hidden");
  el.innerHTML = hints.map(h=>`<div class="nhint ${h.severity==="danger"?"danger":""}"><span class="ic">${h.severity==="danger"?"⚠️":"💡"}</span><span>${esc(h.message)}</span></div>`).join("");
}
function neuralValidCustom(p){
  const spec = neuralRegistry.find(c=>c.type===p.type);
  if(!spec) return false;
  if(!(p.title || "").trim()) return false;
  const sources = spec.allowed_data_sources||[];
  if(sources.length && !sources.includes(p.data_source)) return false;
  return true;
}
function neuralRenderCustomBody(p, d){
  const rows = (key, n=8)=>{
    const list = (d && d[key]) || [];
    if(!list.length) return "（空）";
    const cols = Object.keys(list[0]).slice(0, 3);
    return `<table class="nptbl"><thead><tr>${cols.map(c=>`<th>${esc(c)}</th>`).join("")}</tr></thead><tbody>${list.slice(0,n).map(r=>`<tr>${cols.map(c=>`<td>${esc(typeof r[c]==="object"?JSON.stringify(r[c]):r[c])}</td>`).join("")}</tr>`).join("")}</tbody></table>`;
  };
  const list = d ? ((d[p.data_source]) || []) : [];
  switch(p.type){
    case "metric_card": return `<div class="metric">${list.length||0}</div><div class="metric-cap">${esc(p.data_source||"")}</div>`;
    case "data_table": case "data_list": return rows(p.data_source);
    case "trend_chart": {
      const vals = list.slice(0,8).map(r=>Number(r.total_amount||r.price||r.stock||0));
      const max = Math.max(1, ...vals);
      return vals.length ? `<div class="bars">${vals.map(v=>`<div class="bar" style="height:${Math.round(v/max*100)}%"></div>`).join("")}</div>` : "（无数据）";
    }
    case "pie_chart": {
      const total = list.reduce((a,r)=>a+Number(r.total_amount||r.price||r.stock||0),0)||1;
      const slices = list.slice(0,6);
      let acc=0, stops=[];
      for(const r of slices){ const share = Number(r.total_amount||r.price||r.stock||0)/total; acc+=share; stops.push(acc); }
      const grad = stops.map((stop,i)=>`rgba(109,94,242,${0.35+i*0.1}) ${Math.round((i?slices[i-1].__prev||0:0)*100)}% ${Math.round(stop*100)}%`).join(",");
      return `<div class="pie" style="background:conic-gradient(${grad||"#2d3650"})"></div><div class="pie-cap">${slices.length} 类</div>`;
    }
    case "task_list": return rows("todos");
    case "approval_card": { const pend = (d&&d.approvals||[]).filter(a=>a.status==="PENDING"); return `<div class="row"><span>待审批</span><b>${pend.length}</b></div>`; }
    case "notification_list": return rows("events");
    case "log_viewer": return rows("events");
    case "manager_status": return rows("agents");
    case "filter": return `<div class="row"><span>筛选器</span><span>就绪</span></div>`;
    case "search_box": return `<input class="npsearch" placeholder="搜索…" oninput="neuralSearch(this.value,'${esc(p.id)}')">`;
    case "form": return `<div class="row"><span>表单（写入需网关授权）</span><span>—</span></div>`;
    case "calendar": return rows("todos");
    case "report_reader": return rows("events");
    default: return rows(p.data_source);
  }
}
function neuralSearch(q, id){
  const body = document.getElementById("npbody-"+id);
  if(!body) return;
  const list = neuralFeed || [];
  const hit = list.filter(e=>String(e.action||"").includes(q)||String(e.decision||"").includes(q)).slice(0,8);
  body.innerHTML = hit.length ? hit.map(e=>`<div class="row"><span>${esc(e.action)}</span><span>${esc(e.decision)}</span></div>`).join("") : "（无匹配）";
}
function neuralOpenPanelModal(){
  if(!neuralRegistry.length){ neuralLoadRegistry().then(()=>neuralFillPanelModal()); }
  else neuralFillPanelModal();
}
function neuralFillPanelModal(){
  const sel = $("#npType");
  sel.innerHTML = neuralRegistry.map(c=>`<option value="${esc(c.type)}">${esc(c.type)}${c.required_fields.length?"（需 "+c.required_fields.join("、")+"）":""}</option>`).join("");
  sel.onchange = neuralTypeChanged;
  neuralTypeChanged();
  $("#npErrors").textContent = "";
  $("#npTitle").value = "";
  $("#neuralPanelModal").classList.remove("hidden");
  $("#neuralPanelModal").style.display = "flex";
}
function neuralClosePanelModal(){
  $("#neuralPanelModal").classList.add("hidden");
  $("#neuralPanelModal").style.display = "none";
}
function neuralTypeChanged(){
  const type = $("#npType").value;
  const spec = neuralRegistry.find(c=>c.type===type);
  const row = $("#npSourceRow");
  if(spec && (spec.allowed_data_sources||[]).length){
    row.classList.remove("hidden");
    $("#npSource").innerHTML = (spec.allowed_data_sources||[]).map(s=>`<option value="${esc(s)}">${esc(s)}</option>`).join("");
  } else { row.classList.add("hidden"); }
}
async function neuralAddPanel(){
  const type = $("#npType").value;
  const title = $("#npTitle").value.trim();
  const spec = neuralRegistry.find(c=>c.type===type);
  const data_source = (spec && (spec.allowed_data_sources||[]).length) ? $("#npSource").value : "";
  const errEl = $("#npErrors");
  errEl.textContent = "";
  try{
    const r = await fetchJson(`/workspaces/${state.workspaceId}/panels`,{method:"POST",headers:wsHeaders(),body:JSON.stringify({type, title, data_source, status:"live", version:1})});
    const p = r.panel;
    neuralCustom.push({id:p.panel_id, type:p.type, title:p.title, data_source:p.data_source, version:p.version, status:p.status});
    await neuralSaveCustom();
    neuralClosePanelModal();
    neuralBuildCustom();
    neuralRefreshPanels();
    toast("面板已通过校验并保存到服务端："+title);
  }catch(e){ errEl.textContent = e.message; }
}
async function neuralReset(){
  try{
    const d = await fetchJson(`/workspaces/${state.workspaceId}/panels`,{headers:wsHeaders()});
    for(const p of (d.panels||[])){ await fetchJson(`/workspaces/${state.workspaceId}/panels/${p.panel_id}`,{method:"DELETE",headers:wsHeaders()}); }
    await fetchJson(`/workspaces/${state.workspaceId}/neural/layout`,{method:"PUT",headers:wsHeaders(),body:JSON.stringify({positions:{}})});
  }catch(e){ /* fall back to local reset */ }
  try{ localStorage.removeItem(NEURAL_LS); localStorage.removeItem(NEURAL_CUSTOM_LS); }catch(_){}
  neuralCustom = [];
  neuralPos = {};
  const stage = $("#neuralStage");
  if(stage){ stage.querySelectorAll(".npanel").forEach(el=>el.remove()); }
  neuralBuilt = false;
  neuralBuild();
  neuralBuildCustom();
  toast("神经控制台布局已复位");
}
loadState();
if(state.apiKey && state.workspaceId){ enter(); }
