    box.innerHTML = `<div class="t" style="color:var(--danger)">${esc(e.message)}</div>`;
  }finally{
    btn.disabled = false; btn.textContent = "运行";
  }
}

// ---- data file upload ----
async function uploadFile(input){
  const file = input.files && input.files[0];
  if(!file) return;
  try{
    const buf = await file.arrayBuffer();
    const bytes = new Uint8Array(buf);
    let binary = "";
    const chunk = 0x8000;
    for(let i=0;i<bytes.length;i+=chunk){ binary += String.fromCharCode.apply(null, bytes.subarray(i, i+chunk)); }
    const content_base64 = btoa(binary);
    await fetchJson(`/workspaces/${state.workspaceId}/files`,{method:"POST",headers:wsHeaders(),body:JSON.stringify({name:file.name, content_base64})});
    toast("已上传："+file.name+"，Agent 可用 read_data 读取");
  }catch(e){ toast("上传失败："+e.message); }
  input.value = "";
}

