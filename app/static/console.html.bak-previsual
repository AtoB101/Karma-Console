function neuralRenderFeed(){
  const feed = $("#brainFeed"); if(!feed) return;
  const events = neuralFeed || [];
  if(!events.length){ feed.innerHTML = `<span style="color:var(--muted)">暂无事件 · 任何操作都会经过主脑</span>`; return; }
  feed.innerHTML = events.slice(0,14).map(e=>{
