async function saveChannel(){
  const type = $("#set_channel_type").value;
  const allow_private = $("#set_channel_private").checked;
  const signer = $("#set_channel_signer").value;
  const url = $("#set_channel_url").value.trim();

  if(signer){
    const body = {name:type, endpoint_url:url, method:"POST", signer, allow_private, auth:{type:"none"}};
    const actions = {};
    if(signer==="taobao"){
      body.app_key = $("#set_tb_app_key").value.trim();
      const secret = $("#set_tb_app_secret").value.trim();
      if(secret) body.app_secret = secret;
      const session = $("#set_tb_session").value.trim();
      if(session) body.access_token = session;
      const cm = $("#set_tb_create_method").value.trim();
      const rm = $("#set_tb_read_method").value.trim();
      if(cm) actions.create_order = {method:cm};
      if(rm) actions.read = {method:rm};
    }else if(signer==="douyin"){
      body.app_id = $("#set_dy_app_id").value.trim();
      const secret = $("#set_dy_app_secret").value.trim();
      if(secret) body.app_secret = secret;
      const tok = $("#set_dy_access_token").value.trim();
      if(tok) body.access_token = tok;
      body.sign_method = $("#set_dy_sign_method").value;
      const rm = $("#set_dy_read_method").value.trim();
      if(rm) actions.read = {method:rm};
    }else if(signer==="sfexpress"){
      body.partner_id = $("#set_sf_partner_id").value.trim();
      const checkword = $("#set_sf_checkword").value.trim();
      if(checkword) body.checkword = checkword;
      const sc = $("#set_sf_service_code").value.trim();
      if(sc) actions.read = {service_code:sc};
    }
    if(Object.keys(actions).length) body.actions = actions;
    try{
      const res = await fetchJson(`/workspaces/${state.workspaceId}/connectors/${type}`,{method:"PUT",headers:wsHeaders(),body:JSON.stringify(body)});
      toast("签名渠道已保存：" + res.signer);
      await loadChannelConfig();
    }catch(e){ toast(e.message); }
    return;
  }

  const method = $("#set_channel_method").value;
  const authType = $("#set_channel_auth").value;
  const token = $("#set_channel_token").value.trim();
  const header = $("#set_channel_auth_header").value.trim() || "X-Api-Key";
  const body = {name: type, endpoint_url: url, method, allow_private};
  if(authType === "bearer"){ body.auth = {type:"bearer", token}; }
  else if(authType === "api_key"){ body.auth = {type:"api_key", token, header}; }
  else { body.auth = {type:"none"}; }
  try{
    const res = await fetchJson(`/workspaces/${state.workspaceId}/connectors/${type}`,{method:"PUT",headers:wsHeaders(),body:JSON.stringify(body)});
    toast("渠道回执已保存：" + (res.endpoint_url ? "已接真实回执" : "已清空（回退桩）"));
    await loadChannelConfig();
  }catch(e){ toast(e.message); }
}

