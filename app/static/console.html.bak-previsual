    if(res.decision==="ALLOWED" && res.result && res.result.error){ toast(res.result.error); }
    else if(res.decision==="ALLOWED"){ toast("已签收"); }
    else{ toast(res.reason||res.decision); }
    await loadBiz();
  }catch(e){ toast(e.message); }
}

async function bizCancel(orderId){
